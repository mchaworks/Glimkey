<resources>
    <style name="Theme.Pillboard" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="android:fontFamily">@font/google_sans_rounded</item>
    </style>
    <style name="Theme.Pillboard.App" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/google_sans_rounded</item>
    </style>
    <!-- Used when "Material You colors" is off: fixed Material 3 baseline palette -->
    <style name="Theme.Pillboard.Static" parent="Theme.Material3.DayNight">
        <item name="android:fontFamily">@font/google_sans_rounded</item>
    </style>
    <style name="Theme.Pillboard.App.Static" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/google_sans_rounded</item>
    </style>
    <!-- Theme font overlays, applied on top of the keyboard theme (see KbTheme.fontOverlay) -->
    <style name="Overlay_Font_Serif"><item name="android:fontFamily">serif</item></style>
    <style name="Overlay_Font_Mono"><item name="android:fontFamily">monospace</item></style>
    <style name="Overlay_Font_Medium"><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Overlay_Font_Condensed"><item name="android:fontFamily">sans-serif-condensed</item></style>
</resources>
